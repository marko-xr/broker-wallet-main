<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for push notifications: the Broker Wallet logo (roof with
     chimney, window, wallet with clasp) as a single-colour silhouette on
     transparency, simplified to read at 24 dp. Android draws it as a white
     shape in the status bar and tints it with
     @color/notification_accent in the notification shade. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <group android:translateY="2.5">
        <!-- Roof -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M17,62 L60,21 L103,62 L96,69 L60,35 L24,69 Z" />
        <!-- Chimney -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M78,31 H88 V50 H78 Z" />
        <!-- Window, 2 x 2 panes -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M52,47 h6 v6 h-6 Z M60,47 h6 v6 h-6 Z M52,55 h6 v6 h-6 Z M60,55 h6 v6 h-6 Z" />
        <!-- Wallet body with the notch the clasp sits in -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M36,64 H80 A6,6 0 0 1 86,70 V88 A6,6 0 0 1 80,94 H36 A6,6 0 0 1 30,88 V70 A6,6 0 0 1 36,64 Z M63,70 H86 V88 H63 Z" />
        <!-- Clasp with its button hole -->
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M69,72 H89 A3,3 0 0 1 92,75 V83 A3,3 0 0 1 89,86 H69 A3,3 0 0 1 66,83 V75 A3,3 0 0 1 69,72 Z M69,79 A3,3 0 1 0 75,79 A3,3 0 1 0 69,79 Z" />
    </group>
</vector>
