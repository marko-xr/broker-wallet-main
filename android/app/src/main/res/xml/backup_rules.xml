<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (Auto Backup, android:fullBackupContent).

  Only exclusions are listed, so everything else the app stores keeps being
  backed up exactly as before.

  app_flutter is the directory path_provider returns for
  getApplicationDocumentsDirectory() on Android, and app_flutter/offer_media
  holds adopted originals of private Offer photos — the exact image files a
  user uploaded to their own Offer. Those must not travel to cloud backup or
  to another device. They are re-downloadable from R2 by an authorized
  session, so excluding them costs nothing but a fetch.

  Downloaded Offer photos are not listed here because they live in the cache
  directory, which Auto Backup already excludes.

  offer_media_uploads.hive is the Offer media upload queue. Its entries name
  files inside app_flutter/offer_media, which are not backed up, so a
  restored queue could only report every item as missing.
-->
<full-backup-content>
    <exclude domain="root" path="app_flutter/offer_media" />
    <exclude domain="root" path="app_flutter/offer_media_uploads.hive" />
    <exclude domain="root" path="app_flutter/offer_media_uploads.lock" />
    <!-- Scanner: the account folders of scanned documents and the scanner's own
         working copies stay on this phone (see docs/DECISIONS.md). -->
    <exclude domain="root" path="app_flutter/scanner" />
    <exclude domain="file" path="mlkit_docscan_ui_client" />
    <!-- Combine PDFs: the account folders of combined documents stay on this
         phone (see docs/DECISIONS.md). -->
    <exclude domain="root" path="app_flutter/combine_pdfs" />
    <!-- Images to PDF: the account folders of converted PDFs, their drafts
         and the private copies of selected pictures stay on this phone (see
         docs/DECISIONS.md). -->
    <exclude domain="root" path="app_flutter/image_to_pdf" />
    <!-- Document Signature: the account folders of signed documents and their
         unsaved drafts stay on this phone (see docs/DECISIONS.md). The folder
         an earlier version used (app_flutter/signed_documents) is not listed:
         its files carry no owner and what happens to them is the owner's
         decision. -->
    <exclude domain="root" path="app_flutter/signature_pdfs" />
    <!-- Offline lists: each account's encrypted copy of its server lists.
         Their keys live in the Android Keystore, which a restore or a new
         phone does not receive, so a copy restored here could never be read.
         They refill from the server after sign-in. -->
    <exclude domain="root" path="app_flutter/offline_lists" />
    <!-- Quotation PDFs (Q-2c-1): the private financial PDFs of each account
         and the work folder they are generated in. They are re-downloadable
         from R2 by an authorized session. PDFs an earlier version kept
         directly in app_flutter cannot be listed (their names carry ids). -->
    <exclude domain="root" path="app_flutter/quotation_pdfs" />
    <!-- Private media (M0.5): profile originals uploaded on this phone, the
         media identity map (url_mapping) and the media catalogue
         (local_media) - Hive boxes in app_flutter with their lock and
         compaction files - and the image cache's index database in files/
         (flutter_cache_manager's libCachedImageData.db, which records each
         entry's key and the signed link it was fetched from), with SQLite's
         files beside it. All are rebuilt or re-downloaded after a restore. -->
    <exclude domain="root" path="app_flutter/profile_media" />
    <exclude domain="root" path="app_flutter/url_mapping.hive" />
    <exclude domain="root" path="app_flutter/url_mapping.hivec" />
    <exclude domain="root" path="app_flutter/url_mapping.lock" />
    <exclude domain="root" path="app_flutter/local_media.hive" />
    <exclude domain="root" path="app_flutter/local_media.hivec" />
    <exclude domain="root" path="app_flutter/local_media.lock" />
    <exclude domain="file" path="libCachedImageData.db" />
    <exclude domain="file" path="libCachedImageData.db-journal" />
    <exclude domain="file" path="libCachedImageData.db-wal" />
    <exclude domain="file" path="libCachedImageData.db-shm" />
    <!-- Private image cache (M1b): files/bwPrivateMedia.db, the separate index of
         the private image cache (keys and fixed bw-private-media:// addresses, no
         signed links), with SQLite's files beside it. Its bytes are in the cache
         directory, which is never backed up. -->
    <exclude domain="file" path="bwPrivateMedia.db" />
    <exclude domain="file" path="bwPrivateMedia.db-journal" />
    <exclude domain="file" path="bwPrivateMedia.db-wal" />
    <exclude domain="file" path="bwPrivateMedia.db-shm" />
    <!-- The shared Favorites box of builds before per-account isolation:
         plaintext customer names, never read again and deliberately not
         deleted (see main.dart). Only its exact files are listed. The
         per-account plaintext boxes (cached_favorites_<uid>) cannot be listed
         here, their names carry the account id; each is removed once that
         account's encrypted copy (in offline_lists) is in place. -->
    <exclude domain="root" path="app_flutter/cached_favorites.hive" />
    <exclude domain="root" path="app_flutter/cached_favorites.lock" />
</full-backup-content>
