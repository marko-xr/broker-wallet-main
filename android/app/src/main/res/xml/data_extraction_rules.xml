<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31) and above, which uses android:dataExtractionRules
  instead of android:fullBackupContent.

  Same narrow intent as backup_rules.xml: only exclusions, so every other
  backup and device-transfer behaviour is unchanged. app_flutter/offer_media
  holds adopted originals of private Offer photos, which must not leave the
  device through cloud backup or a device-to-device transfer. They remain
  re-downloadable from R2 by an authorized session.

  Both sections are listed because they are independent: omitting
  device-transfer would still let the files move to a new phone.

  offer_media_uploads.hive is the Offer media upload queue, whose entries
  name files in app_flutter/offer_media; without those files a restored
  queue could only report every item as missing.
-->
<!--
  app_flutter/offline_lists: each account's encrypted offline lists. Their
  keys stay in the Android Keystore, which neither a cloud restore nor a
  device transfer carries, so a copied box could never be read; they refill
  from the server after sign-in.
-->
<!--
  app_flutter/cached_favorites.hive / .lock: the shared Favorites box of builds
  before per-account isolation (plaintext customer names), never read again and
  deliberately not deleted. Only its exact files are listed. The per-account
  plaintext boxes (cached_favorites_<uid>) cannot be listed, their names carry
  the account id; each is removed once that account's encrypted copy (in
  offline_lists) is in place.
-->
<!--
  app_flutter/quotation_pdfs (Q-2c-1): each account's private financial
  Quotation PDFs and the work folder they are generated in; re-downloadable
  from R2 by an authorized session. PDFs an earlier version kept directly in
  app_flutter cannot be listed (their names carry ids).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/offer_media" />
        <exclude domain="root" path="app_flutter/offer_media_uploads.hive" />
        <exclude domain="root" path="app_flutter/offer_media_uploads.lock" />
        <exclude domain="root" path="app_flutter/scanner" />
        <exclude domain="root" path="app_flutter/combine_pdfs" />
        <exclude domain="root" path="app_flutter/image_to_pdf" />
        <exclude domain="root" path="app_flutter/signature_pdfs" />
        <exclude domain="root" path="app_flutter/offline_lists" />
        <exclude domain="root" path="app_flutter/quotation_pdfs" />
        <exclude domain="file" path="mlkit_docscan_ui_client" />
        <exclude domain="root" path="app_flutter/cached_favorites.hive" />
        <exclude domain="root" path="app_flutter/cached_favorites.lock" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/offer_media" />
        <exclude domain="root" path="app_flutter/offer_media_uploads.hive" />
        <exclude domain="root" path="app_flutter/offer_media_uploads.lock" />
        <exclude domain="root" path="app_flutter/scanner" />
        <exclude domain="root" path="app_flutter/combine_pdfs" />
        <exclude domain="root" path="app_flutter/image_to_pdf" />
        <exclude domain="root" path="app_flutter/signature_pdfs" />
        <exclude domain="root" path="app_flutter/offline_lists" />
        <exclude domain="root" path="app_flutter/quotation_pdfs" />
        <exclude domain="file" path="mlkit_docscan_ui_client" />
        <exclude domain="root" path="app_flutter/cached_favorites.hive" />
        <exclude domain="root" path="app_flutter/cached_favorites.lock" />
    </device-transfer>
</data-extraction-rules>
